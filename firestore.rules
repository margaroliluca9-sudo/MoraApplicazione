// REGOLE DEL DATABASE (da incollare in Firebase Console → Firestore Database → Regole → Pubblica).
// Solo chi è entrato con nome e password (pass firmato da /api/login, vedi api/_auth.js)
// può leggere e scrivere. Chi non ha il pass (script, curiosi, accessi anonimi) non vede niente.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{app}/public/data/{rest=**} {
      allow read, write: if request.auth != null && request.auth.token.mora == true;
    }
  }
}
